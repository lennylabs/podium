Review the diff and report defects.

=== .cursor/hooks.json ===
{
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "./scripts/fmt.sh",
        "x-podium-id": "team/fmt"
      }
    ],
    "stop": [
      {
        "command": "echo done\necho bye",
        "x-podium-id": "team/notify"
      }
    ]
  },
  "version": 1
}

=== .cursor/mcp.json ===
{
  "mcpServers": {
    "warehouse": {
      "args": [
        "@acme/warehouse-mcp"
      ],
      "command": "npx"
    }
  },
  "x-podium": {
    "team/warehouse": [
      "mcpServers",
      "warehouse"
    ]
  }
}

=== .cursor/rules/deep-review.mdc ===
